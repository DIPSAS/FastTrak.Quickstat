<Project Sdk="Microsoft.NET.Sdk">

  <!--
    QuickStat.App - the WPF application.

    HARD CONSTRAINT: AssemblyName MUST be "QuickStat" so the executable is QuickStat.exe.  Config
    discovery in the deployed product is ChangeFileExt(ParamStr(0), '.config.xml'); renaming the
    assembly stops QuickStat.config.xml resolving for every existing installation
    (PORT-PLAN.md §4.1).  Do not "tidy" this to match the project name.
  -->

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>

    <AssemblyName>QuickStat</AssemblyName>
    <RootNamespace>QuickStat</RootNamespace>

    <!-- Existing icon at the repository root; not copied, not moved. -->
    <ApplicationIcon>..\QuickStat_Icon.ico</ApplicationIcon>

    <!-- Per-monitor DPI v2, asInvoker, common controls v6. -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\QuickStat.Core\QuickStat.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      The same .ico again, this time embedded so XAML can address it.  ApplicationIcon above only
      stamps the executable's shell icon; the banner in the shell window (05-ui-spec.md §A.2,
      imgAppIcon) needs it as an assembly resource, reachable as
      pack://application:,,,/QuickStat;component/Assets/QuickStat_Icon.ico.  Linked rather than
      copied so the repository keeps one icon file (PORT-PLAN.md §6, Phase 6 keeps QuickStat_Icon.ico).
    -->
    <Resource Include="..\QuickStat_Icon.ico" Link="Assets\QuickStat_Icon.ico" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="QuickStat.Tests" />
  </ItemGroup>

</Project>

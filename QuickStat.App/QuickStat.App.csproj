<Project Sdk="Microsoft.NET.Sdk">

  <!--
    QuickStat.App - the WPF application.

    HARD CONSTRAINT: AssemblyName MUST be "QuickStat" so the executable is QuickStat.exe.  Config
    discovery in the deployed product is ChangeFileExt(ParamStr(0), '.config.xml'); renaming the
    assembly stops QuickStat.config.xml resolving for every existing installation
    (PORT-PLAN.md §4.1).  Do not "tidy" this to match the project name.
  -->

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>

    <AssemblyName>QuickStat</AssemblyName>
    <RootNamespace>QuickStat</RootNamespace>

    <!-- Existing icon at the repository root; not copied, not moved. -->
    <ApplicationIcon>..\QuickStat_Icon.ico</ApplicationIcon>

    <!-- Per-monitor DPI v2, asInvoker, common controls v6. -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />

    <!--
      Serilog lives here and ONLY here.  QuickStat.Core must never reference it: it takes
      Microsoft.Extensions.Logging.Abstractions, and Serilog is plugged in behind that as a single
      MEL provider by QuickStat.App/Logging/QuickStatLog.cs.  See Directory.Packages.props.
    -->
    <PackageReference Include="Serilog" />
    <PackageReference Include="Serilog.Extensions.Logging" />
    <PackageReference Include="Serilog.Sinks.File" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\QuickStat.Core\QuickStat.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      TWO icons, and they are different pictures.  ApplicationIcon above only stamps the executable's
      shell icon, so the window (MainWindow.xaml) and the banner (05-ui-spec.md §A.2, imgAppIcon) each
      need one as an assembly resource, reachable as
      pack://application:,,,/QuickStat;component/Assets/<name>.  Linked rather than copied so the
      repository keeps one copy of each file (PORT-PLAN.md §6, Phase 6 keeps both).

        QuickStat_Icon.ico          line chart on a grid.  The shell icon, the title bar, the taskbar.
        QuickStat_Banner_Icon.ico   area chart on a grid.  The 32 x 32 wordmark icon, and ONLY that.

      The second one was carried inside MainQuickStat.dfm as imgAppIcon.Picture.Data rather than as a
      file, which is why the port shipped the first one in both places until somebody noticed the
      banner had changed picture.  It is extracted byte for byte; the .dfm keeps its copy, because
      the Delphi build still reads it.
    -->
    <Resource Include="..\QuickStat_Icon.ico" Link="Assets\QuickStat_Icon.ico" />
    <Resource Include="..\QuickStat_Banner_Icon.ico" Link="Assets\QuickStat_Banner_Icon.ico" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="QuickStat.Tests" />
  </ItemGroup>

</Project>

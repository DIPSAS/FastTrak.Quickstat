<Window x:Class="QuickStat.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:conv="clr-namespace:QuickStat.Converters"
        xmlns:dialogs="clr-namespace:QuickStat.Views.Dialogs"
        xmlns:views="clr-namespace:QuickStat.Views"
        xmlns:vm="clr-namespace:QuickStat.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Title="{Binding WindowTitle, Mode=OneTime}"
        Width="1320"
        Height="840"
        MinWidth="900"
        MinHeight="600"
        Background="{StaticResource QsFormFaceBrush}"
        FontFamily="{StaticResource QsFontFamily}"
        FontSize="{StaticResource QsFontSize}"
        Foreground="{StaticResource QsTextBrush}"
        Icon="pack://application:,,,/QuickStat;component/Assets/QuickStat_Icon.ico"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        WindowStartupLocation="CenterScreen">

    <!--
        05-ui-spec.md §A.1-§A.3.  Design client size 1290 x 785; 1320 x 840 with the frame.  The
        minimum size is an addition - the Delphi sets none - and is flagged as such in §A.1.

        Cursor tracks IsBusy: the Delphi's Screen.Cursor := crSqlWait, now driven by a flag rather
        than by try/finally, because the work is asynchronous (§G.3).
    -->

    <Window.Style>
        <Style TargetType="Window">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsBusy}" Value="True">
                    <Setter Property="Cursor" Value="Wait" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Style>

    <Grid>
        <DockPanel>
            <views:AppBannerView DockPanel.Dock="Top" />

            <Grid>
                <Grid.ColumnDefinitions>
                    <!--
                        splMain.Position = 293 in the .dfm.  §I.1 records that the screenshots show
                        about 336 and the brief says about 330; the spec specifies 293 with a
                        minimum of 260 and step 3.1 takes that.  The width is now persisted (§G.1's
                        recommended addition), so a user who prefers wider drags once.
                    -->
                    <ColumnDefinition x:Name="LeftColumn" Width="293" MinWidth="260" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" MinWidth="360" />
                </Grid.ColumnDefinitions>

                <TabControl x:Name="SelectionTabs"
                            Grid.Column="0"
                            Style="{StaticResource QsTabControl}"
                            SelectedIndex="{Binding SelectedSelectionTab, Mode=TwoWay}">

                    <TabItem Header="Population">
                        <views:PopulationTabView DataContext="{Binding Population}" />
                    </TabItem>

                    <!--
                        §B.0, and it is easy to miss: hidden AND disabled until a population is
                        loaded, then shown and activated by the view-model.  Collapsed rather than
                        Hidden - a TabItem set to Hidden still occupies its strip slot - and
                        disabled as well, or Ctrl+Tab still reaches it.
                    -->
                    <TabItem Header="Collections"
                             IsEnabled="{Binding HasPopulation}"
                             Visibility="{Binding HasPopulation, Converter={conv:BoolToVisibilityConverter}}">
                        <views:CollectionsTabView DataContext="{Binding Collections}" />
                    </TabItem>

                    <TabItem Header="Packages">
                        <views:PackagesTabView DataContext="{Binding Packages}" />
                    </TabItem>
                </TabControl>

                <GridSplitter Grid.Column="1"
                              Style="{StaticResource QsSplitter}"
                              DragCompleted="OnSplitterDragCompleted" />

                <!--
                    §C.2: the right pane is a plain content host, not a TabControl.  Its only other
                    tab was "Time series" - an empty, permanently disabled TRzTabSheet with no code
                    behind it at all - and PORT-PLAN.md §7.1 drops it.
                -->
                <views:DatasetTabView Grid.Column="2" DataContext="{Binding Dataset}" />
            </Grid>
        </DockPanel>

        <dialogs:BusyOverlayView x:Name="BusyOverlay" />
    </Grid>
</Window>

<Application x:Class="QuickStat.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        Deliberately NO StartupUri.  The generic host owns the composition root: App.OnStartup
        resolves MainWindow from DI and shows it.  A StartupUri here would open a second, un-injected
        window on top of it.

        Only the styles dictionary is merged.  It pulls QuickStat.Brushes.xaml in itself, because
        StaticResource is resolved when a dictionary is parsed and the styles would otherwise be
        unloadable on their own - which is what the theme test does.  Listing both here would merge
        the brushes twice and give every key two instances.

        Theme/** is step 3.1's; see Docs/Port/07-ui-contracts.md before adding a key.
    -->
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/QuickStat;component/Theme/QuickStat.Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>

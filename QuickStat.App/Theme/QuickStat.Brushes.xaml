<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
                    mc:Ignorable="po">

    <!--
        QuickStat palette.  Transcribed key for key and value for value from Docs/Port/05-ui-spec.md
        §F.4; §F.1 records where each colour came from (a Delphi $00BBGGRR constant plus a pixel
        sample of the shipped build).  Step 3.1 owns this file.

        DO NOT add a key here without adding it to 05-ui-spec.md §F.4 as well:
        QuickStat.Tests/Ui/Theme/ThemeResourceTests.cs asserts the inventory, and a brush that only
        exists in one of the two places is a brush the next reader cannot trust.

        Every brush is frozen.  They are shared across the whole application, so a consumer that
        mutated one would change it for everybody; freezing turns that into an exception instead of
        a rendering mystery, and lets WPF skip change tracking.
    -->

    <!-- Brand -->
    <SolidColorBrush x:Key="QsTealBrush"           Color="#178891" po:Freeze="True" /><!-- section headers, selection -->
    <SolidColorBrush x:Key="QsTealDarkBrush"       Color="#035F66" po:Freeze="True" /><!-- PID column text -->
    <SolidColorBrush x:Key="QsTealHoverBrush"      Color="#1A9BA6" po:Freeze="True" /><!-- new: header hover -->
    <SolidColorBrush x:Key="QsTealUnfocusedBrush"  Color="#50AEB6" po:Freeze="True" />

    <!-- Surfaces -->
    <SolidColorBrush x:Key="QsBannerBrush"         Color="#FFFFFF" po:Freeze="True" />
    <SolidColorBrush x:Key="QsPageBrush"           Color="#F4FBFB" po:Freeze="True" /><!-- tab pages, splitter -->
    <SolidColorBrush x:Key="QsSurfaceBrush"        Color="#FFFFFF" po:Freeze="True" /><!-- lists, grid, editors -->
    <SolidColorBrush x:Key="QsAltRowBrush"         Color="#F7F7F7" po:Freeze="True" />
    <SolidColorBrush x:Key="QsFormFaceBrush"       Color="#EEEEEE" po:Freeze="True" />

    <!-- Lines -->
    <SolidColorBrush x:Key="QsBorderBrush"         Color="#D0D6D6" po:Freeze="True" /><!-- modernised from #A0A0A0 -->
    <SolidColorBrush x:Key="QsBorderStrongBrush"   Color="#9AA5A5" po:Freeze="True" /><!-- modernised from #646464 -->
    <SolidColorBrush x:Key="QsGridLineBrush"       Color="#E2E6E6" po:Freeze="True" /><!-- modernised from #C0C0C0 -->
    <SolidColorBrush x:Key="QsDividerBrush"        Color="#EDF1F1" po:Freeze="True" />

    <!-- Text -->
    <SolidColorBrush x:Key="QsTextBrush"           Color="#202020" po:Freeze="True" />
    <SolidColorBrush x:Key="QsTitleBrush"          Color="#333333" po:Freeze="True" />
    <SolidColorBrush x:Key="QsMutedTextBrush"      Color="#5E6A6A" po:Freeze="True" />
    <SolidColorBrush x:Key="QsOnAccentBrush"       Color="#FFFFFF" po:Freeze="True" />
    <SolidColorBrush x:Key="QsCodeBrush"           Color="#888888" po:Freeze="True" /><!-- population/package id; measured, see below -->
    <SolidColorBrush x:Key="QsCategoryBrush"       Color="#894605" po:Freeze="True" /><!-- ProcGroup / Pop#n; measured, see below -->
    <SolidColorBrush x:Key="QsAccentBrush"         Color="#0078D7" po:Freeze="True" /><!-- "version" label -->

    <!--
        Severity.  Both were literals inside step 3.6's dialog until Phase 5 (PORT-PLAN.md §8.10 e):
        that step was not allowed to add a brush, so it wrote the hex twice and reported it.

        QsErrorBrush is not new paint - it is the red the banner's failed status line has always used
        (§G.2), lifted out of AppBannerView so the two cannot drift.  QsWarningBrush has no Delphi
        precedent at all: the VCL dialogs had no warning severity, so this is an addition, chosen to
        sit beside the red at a similar weight rather than sampled from anything.
    -->
    <SolidColorBrush x:Key="QsErrorBrush"          Color="#C42B1C" po:Freeze="True" /><!-- failed status line, error glyph -->
    <SolidColorBrush x:Key="QsWarningBrush"        Color="#9D5D00" po:Freeze="True" /><!-- warning glyph; addition -->

    <!-- Grid semantics -->
    <SolidColorBrush x:Key="QsCellEmptyBrush"      Color="#F5F5F5" po:Freeze="True" />
    <SolidColorBrush x:Key="QsCellNoDataBrush"     Color="#FFFAFA" po:Freeze="True" />
    <SolidColorBrush x:Key="QsCurrentCellBrush"    Color="#C8D9E9" po:Freeze="True" /><!-- clFocusedSelectionColor; measured, see below -->
    <SolidColorBrush x:Key="QsCurrentRowBrush"     Color="#F3F9FD" po:Freeze="True" /><!-- = Blend(white, tint, 50) -->
    <SolidColorBrush x:Key="QsUnfocusedSelectionBrush" Color="#E7F2FC" po:Freeze="True" /><!-- clUnfocusedSelectionColor, unblended -->
    <SolidColorBrush x:Key="QsHintBackgroundBrush" Color="#FFFFE1" po:Freeze="True" />
    <SolidColorBrush x:Key="QsHintBorderBrush"     Color="#D8D2A8" po:Freeze="True" />

    <!-- Progress -->
    <SolidColorBrush x:Key="QsProgressBrush"       Color="#06B025" po:Freeze="True" />
    <SolidColorBrush x:Key="QsProgressTrackBrush"  Color="#E3E9E9" po:Freeze="True" />

    <!--
        QsCodeBrush and QsCategoryBrush were transcribed from §F.4 as #4B29A4 and #B82E82 and both
        were wrong.  §F.4 describes this repository's develop_old copy of the shared library; commit
        98f493bbc (2022-09-29) changed both, three months before the shipped v22.12.21.547.  Phase 5
        ran that binary against EFT00028_TEST_020 and sampled the stroke cores of the two columns:
        #888888 and #894605 exactly, no interpretation.  PORT-PLAN.md §8.9 (a) has the full table.

        QsCurrentCellBrush is the third of that set and was left at #FFFBD4 through most of Phase 5,
        because the grid holds no rows until a collect run and there was nothing to click.  A later
        Phase 5 pass ran the collect: 213 data elements over population 282, then one click on a data
        cell.  #C8D9E9 appeared, 933 px of it, in a grid that had held none of it before - one cell,
        exactly.  #FFFBD4 is not on the screen at all, and neither is clWebOrange (#FFA500), which is
        what TStudyOverviewGrid.UpdateStyle would set if anything ever called it; nothing does, so
        the constructor's clFocusedSelectionColor stands.  All three of §F.4's disputed colours are
        now sampled off the running binary.

        QsCurrentRowBrush moved with it, from #F3F9FE to #F3F9FD, for a different reason: it is
        Blend(white, #E7F2FC, 50) and the blend was rounding the wrong way.  See
        MatrixGridPalette.Blend and PORT-PLAN.md §8.14.

        QsUnfocusedSelectionBrush is clUnfocusedSelectionColor itself, unblended.  The two lists paint
        a selection with the raw pair - clFocusedSelectionColor when focused, clUnfocusedSelectionColor
        when not (Emetra.VclUtil.ListBoxPainter.pas:490-492, Emetra.VclComp.ListView.pas:271-272) - and
        only the grid blends.  QsPackageItem used QsCurrentRowBrush for its unfocused state, which is
        the blend result and a colour no list in the Delphi ever shows; 05-ui-spec.md §B.3 always said
        #E7F2FC.  PORT-PLAN.md §8.14.
    -->

</ResourceDictionary>

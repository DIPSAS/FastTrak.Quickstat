<UserControl x:Class="QuickStat.Views.PopulationTabView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:q="clr-namespace:QuickStat.Controls"
             xmlns:views="clr-namespace:QuickStat.Views"
             xmlns:vm="clr-namespace:QuickStat.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:PopulationTabViewModel}">

    <!--
        OWNER: step 3.2.  05-ui-spec.md §B.1.
    -->

    <DockPanel Margin="4">
        <q:SectionHeader DockPanel.Dock="Top" Margin="3" Header="Select database" />

        <!--
            cbProject: csDropDownList (so not editable), DropDownCount = 24 - which QsFlatComboBox
            turns into MaxDropDownHeight - sorted by name, and NOTHING preselected.  Choosing an
            entry is what connects; see PopulationTabViewModel.LastDatabase for why the remembered
            database is not filled in here.
        -->
        <ComboBox DockPanel.Dock="Top"
                  Margin="3,0,3,3"
                  Style="{StaticResource QsFlatComboBox}"
                  DisplayMemberPath="Name"
                  IsEditable="False"
                  ItemsSource="{Binding Projects}"
                  SelectedItem="{Binding SelectedProject, Mode=TwoWay}">
            <!--
                DisplayMemberPath decides what is DRAWN.  It does not name the row for a screen
                reader: an item peer takes its name from the container, and with nothing there it
                falls back to the item's own ToString - which for a record is every property it has,
                ConnectionString included.  Measured on the running build, this combo announced
                "QuickStatConnection { Name = ..., ConnectionString = FILE NAME=.\FastTrak.UDL, ... }"
                per entry.  A UDL path is harmless; a <ConnectionString> element with credentials in
                it, which the format allows, would have been read out loud and copied into every UIA
                client's cache.  R6.  QuickStatConnection.ToString is the other half - see there for
                why one binding is not enough.
            -->
            <ComboBox.ItemContainerStyle>
                <Style TargetType="{x:Type ComboBoxItem}">
                    <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
                </Style>
            </ComboBox.ItemContainerStyle>
        </ComboBox>

        <q:SectionHeader DockPanel.Dock="Top" Margin="3" Header="Select population" />

        <TextBlock DockPanel.Dock="Bottom"
                   Margin="3"
                   Foreground="{StaticResource QsMutedTextBrush}"
                   Text="Tip: Double click to prepare population" />

        <views:PopulationPickerView Margin="3,0,3,3" DataContext="{Binding Picker}" />
    </DockPanel>
</UserControl>

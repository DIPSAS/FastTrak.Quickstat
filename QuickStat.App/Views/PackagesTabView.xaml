<UserControl x:Class="QuickStat.Views.PackagesTabView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:input="clr-namespace:QuickStat.Input"
             xmlns:q="clr-namespace:QuickStat.Controls"
             xmlns:theme="clr-namespace:QuickStat.Theme"
             xmlns:vm="clr-namespace:QuickStat.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:PackagesTabViewModel}">

    <!--
        OWNER: step 3.4.  Layout skeleton by step 3.1; 05-ui-spec.md §B.3, §D.3.
        The teal header says "Packaged datasets", not "Packages" - that is only the tab caption.

        The list binds to PackagesView, not to Packages: the filter is an ICollectionView over the
        loaded rows, so filtering never touches the model and the selection survives a keystroke that
        does not hide the selected row.
    -->

    <DockPanel Margin="4">
        <q:SectionHeader DockPanel.Dock="Top" Margin="3" Header="Packaged datasets" />

        <TextBox DockPanel.Dock="Top"
                 Margin="3,0,3,3"
                 Style="{StaticResource QsFlatTextBox}"
                 Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}" />

        <StackPanel DockPanel.Dock="Top" Margin="3,0,3,3" Orientation="Horizontal">
            <Button Style="{StaticResource QsToolButton}"
                    Command="{Binding DeletePackageCommand}"
                    ToolTip="Delete this package">
                <TextBlock Style="{StaticResource QsIconGlyph}" Text="{x:Static theme:SegoeIcons.Delete}" />
            </Button>
        </StackPanel>

        <!--
            Double click replays the package (§B.3), and it is the ONLY way in - the Delphi's
            lbPackagedGrids is a plain TListBox with OnDblClick and no Enter equivalent, so there is
            deliberately no KeyBinding beside it.  That made the spelling load-bearing: a
            MouseBinding here never fires, because ListBoxItem handles the mouse-down it selects
            itself with and the event stops below the ListBox that owns the binding.  The replay was
            unreachable by any input at all until this became input:DoubleClick, which hangs off
            Control.MouseDoubleClick - raised by the item, and bubbling.
        -->
        <ListBox Margin="3,0,3,3"
                 BorderBrush="{StaticResource QsBorderBrush}"
                 BorderThickness="1"
                 HorizontalContentAlignment="Stretch"
                 input:DoubleClick.Command="{Binding OpenPackageCommand}"
                 ItemsSource="{Binding PackagesView}"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 SelectedItem="{Binding SelectedPackage, Mode=TwoWay}">

            <!--
                QsPackageItem plus the row's accessible name; see PopulationPickerView.xaml for why
                the name is not in the theme with the rest of the chrome.  Two packages may share a
                title, so the name leads with the row id, exactly as the row itself does.
            -->
            <ListBox.ItemContainerStyle>
                <Style TargetType="{x:Type ListBoxItem}" BasedOn="{StaticResource QsPackageItem}">
                    <Setter Property="AutomationProperties.Name" Value="{Binding AutomationName}" />
                </Style>
            </ListBox.ItemContainerStyle>

            <ListBox.ContextMenu>
                <ContextMenu>
                    <MenuItem Command="{Binding PlacementTarget.DataContext.DeletePackageCommand,
                                                RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                              Header="Delete this package">
                        <MenuItem.Icon>
                            <TextBlock Style="{StaticResource QsIconGlyph}"
                                       Text="{x:Static theme:SegoeIcons.Delete}" />
                        </MenuItem.Icon>
                    </MenuItem>
                </ContextMenu>
            </ListBox.ContextMenu>

            <ListBox.ItemTemplate>
                <!--
                    §B.3, the package row.  Two lines, variable height:

                      41   | Diabetes basissett 2024                | Pop#257
                      QsCodeBrush, QsTitleBrush bold + ellipsis, QsCategoryBrush right, one pt down
                      ..................................................................
                      Comment text, word-wrapped, QsTitleBrush

                    The chrome - the 2 px horizontal padding, the absent vertical padding, the
                    #F0F0F0 divider and the two selected colours - is QsPackageItem's, not this
                    template's.  An empty comment collapses rather than reserving a blank line: the
                    VCL measured the drawn text, so a package saved without one was a single-line
                    row there too.

                    The title is Bold, and it is deliberately not SemiBold: with SemiBold this build
                    drew it pixel for pixel identically to the comment beneath it, measured off the
                    screen.  PORT-PLAN.md §8.11 (14); pinned by PackagesViewMarkupTests.
                -->
                <DataTemplate DataType="{x:Type vm:PackageViewModel}">
                    <StackPanel Margin="0,2">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" MinWidth="32" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0"
                                       Foreground="{StaticResource QsCodeBrush}"
                                       Text="{Binding RowId}" />
                            <TextBlock Grid.Column="1"
                                       Margin="6,0"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource QsTitleBrush}"
                                       Text="{Binding Title}"
                                       TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding Title}" />
                            <TextBlock Grid.Column="2"
                                       VerticalAlignment="Center"
                                       FontSize="{StaticResource QsSmallFontSize}"
                                       Foreground="{StaticResource QsCategoryBrush}"
                                       Text="{Binding PopulationLabel}"
                                       TextAlignment="Right" />
                        </Grid>

                        <TextBlock x:Name="Comment"
                                   Foreground="{StaticResource QsTitleBrush}"
                                   Text="{Binding Comment}"
                                   TextWrapping="Wrap" />
                    </StackPanel>

                    <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding Comment}" Value="">
                            <Setter TargetName="Comment" Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </DataTemplate.Triggers>
                </DataTemplate>
            </ListBox.ItemTemplate>

        </ListBox>
    </DockPanel>
</UserControl>

<UserControl x:Class="QuickStat.Views.DatasetTabView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:grid="clr-namespace:QuickStat.Controls.Dataset"
             xmlns:q="clr-namespace:QuickStat.Controls"
             xmlns:theme="clr-namespace:QuickStat.Theme"
             xmlns:vm="clr-namespace:QuickStat.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:DatasetViewModel}"
             Background="{StaticResource QsPageBrush}">

    <!--
        05-ui-spec.md §C.1: the teal caption bar with 'Wide columns' in its right-hand slot, the
        bordered grid host, the floating data hint, and 'Show data hint' along the bottom.
        Step 3.1 owns this file; the grid inside it is step 3.5's control and is only bound to.
    -->

    <UserControl.Resources>
        <!--
            mnuGridPopup, §D.2, verified character for character against screenshot 4.  Two of the
            four captions are deliberately different from the actions' own: the .dfm overrides them
            on the menu items.

            Used TWICE - by the grid, as its right-click menu, and by the 'Export' button in the
            caption bar, which is an addition (see there).  x:Shared="False" is what makes that legal:
            a ContextMenu is an element, one element has one parent, and without this the second
            reference would steal it from the first.  Each StaticResource then gets its own instance,
            and each takes its DataContext from its own PlacementTarget.

            One definition rather than two, on purpose.  Three captions, three commands and three
            glyphs written out in two places is three pairs that can drift, and the whole point of
            the button is that it offers exactly what the right-click offers.
        -->
        <ContextMenu x:Key="DatasetActionsMenu"
                     x:Shared="False"
                     d:DataContext="{d:DesignInstance Type=vm:DatasetViewModel}">
            <MenuItem Header="Package dataset specification for reuse"
                      Command="{Binding SaveDataPackageCommand}">
                <MenuItem.Icon>
                    <TextBlock Style="{StaticResource QsIconGlyph}" Text="{x:Static theme:SegoeIcons.Package}" />
                </MenuItem.Icon>
            </MenuItem>

            <Separator />

            <MenuItem Header="Open this dataset in Excel"
                      Command="{Binding OpenInExcelCommand}">
                <MenuItem.Icon>
                    <TextBlock Style="{StaticResource QsIconGlyph}"
                               Foreground="#107C41"
                               Text="{x:Static theme:SegoeIcons.Excel}" />
                </MenuItem.Icon>
            </MenuItem>

            <MenuItem Header="Save this dataset to CSV file"
                      Command="{Binding SaveDatasetToCsvCommand}">
                <MenuItem.Icon>
                    <TextBlock Style="{StaticResource QsIconGlyph}" Text="{x:Static theme:SegoeIcons.Save}" />
                </MenuItem.Icon>
            </MenuItem>
        </ContextMenu>
    </UserControl.Resources>

    <DockPanel Margin="4">

        <!--
            Delphi panHdrYourDataset: the caption label fills the bar and cbWideColumns is anchored
            to its right edge with the caption to the LEFT of the box (Alignment = taLeftJustify),
            one point smaller than the header text.
        -->
        <q:SectionHeader DockPanel.Dock="Top"
                         Margin="3,3,3,0"
                         Header="{Binding CaptionText}">
            <StackPanel Orientation="Horizontal">
                <!--
                    ADDITION, flagged: the Delphi has no such button.  Its three dataset actions live
                    only on the grid's right-click menu (§D.2), which is a menu a user has to already
                    know is there - and two of the three are the exports, which is what somebody who
                    has just collected a dataset is looking for.  This offers the same menu from a
                    place that can be seen.

                    The SAME menu, not a copy: DatasetActionsMenu is one definition, and the button
                    and the grid each get an instance of it.  Click opens it, because a ContextMenu
                    otherwise waits for a right-click - DatasetTabView.xaml.cs, which also has to
                    place it under the button rather than at the pointer.

                    Left of 'Wide columns', which stays flush right where the Delphi anchors it.
                -->
                <Button x:Name="ExportButton"
                        Style="{StaticResource QsCaptionButton}"
                        AutomationProperties.Name="Export"
                        Click="OnExportClick"
                        ContextMenu="{StaticResource DatasetActionsMenu}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock VerticalAlignment="Center" Text="Export" />

                        <TextBlock Margin="5,0,0,0"
                                   Style="{StaticResource QsIconGlyph}"
                                   FontSize="10"
                                   Text="{x:Static theme:SegoeIcons.ChevronDown}" />
                    </StackPanel>
                </Button>

                <CheckBox Margin="14,0,0,0"
                          Style="{StaticResource QsCaptionLeftCheckBox}"
                          Foreground="{StaticResource QsOnAccentBrush}"
                          IsChecked="{Binding WideColumns, Mode=TwoWay}">
                    <!--
                        The style puts the caption to the left of the box and keeps the checkmark
                        from being mirrored with it; LeftToRight here stops the caption itself being
                        mirrored.  Still one CheckBox, so the caption is clickable and the automation
                        name is derived from it.
                    -->
                    <TextBlock FlowDirection="LeftToRight" Text="Wide columns" />
                </CheckBox>
            </StackPanel>
        </q:SectionHeader>

        <!--
            Delphi panSettings, docked at the very bottom, checked by default.
        -->
        <CheckBox DockPanel.Dock="Bottom"
                  Margin="3,4,3,3"
                  Content="Show data hint"
                  IsChecked="{Binding ShowDataHint, Mode=TwoWay}" />

        <!--
            Delphi panGrid: a one-pixel bordered container holding the grid and, on top of it, the
            hint panel.  The hint is a Canvas child rather than a Popup: a Popup is a separate
            top-level window, so it survives the owner moving, floats above other applications, and
            has to be closed by hand on deactivation.  This is a panel parented to the grid host,
            which is exactly what the Delphi does (panHint.Parent := panGrid).
        -->
        <Border Margin="3"
                Background="{StaticResource QsSurfaceBrush}"
                BorderBrush="{StaticResource QsBorderStrongBrush}"
                BorderThickness="1">
            <Grid ClipToBounds="True">
                <!--
                    The grid implements IScrollInfo and drives both bars itself, but only a
                    ScrollViewer ever calls it: LineDown, PageDown and MouseWheelDown are members of
                    that interface, not handlers.  Without this host the wheel did nothing and there
                    were no scrollbars at all, so a dataset taller than the pane could only be
                    reached with the arrow keys - see PORT-PLAN.md §8.11 (6).  CanContentScroll is
                    the load-bearing attribute: with it False the ScrollViewer would ignore
                    IScrollInfo and try to scroll the element as one tall bitmap instead, and the
                    grid has no height to scroll - it paints its own viewport.

                    Focusable=False keeps the caret on the grid, whose OnKeyDown already handles
                    every navigation key and marks it handled, so the ScrollViewer never competes
                    for one.  Auto on both bars is the Delphi's ssBoth: TCustomGrid shows a bar only
                    while there is something behind it.

                    The hint Canvas stays a sibling of the ScrollViewer rather than moving inside
                    it.  TryGetCellBounds answers in the grid's own coordinates, and the grid is
                    arranged at the ScrollViewer's origin, so the two spaces still coincide - but
                    inside, the hint would scroll away from the cell it describes.
                -->
                <ScrollViewer CanContentScroll="True"
                              Focusable="False"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Auto">
                    <grid:MatrixGrid x:Name="Grid"
                                 Matrix="{Binding Matrix, Mode=OneWay}"
                                     Identification="{Binding IdentificationMode, Mode=OneWay}"
                                     DataColumnWidth="{Binding DataColumnWidth, Mode=OneWay}"
                                     ContextMenu="{StaticResource DatasetActionsMenu}"
                                     GridLineBrush="{StaticResource QsGridLineBrush}"
                                     FixedCellBackground="{StaticResource QsPageBrush}"
                                     FixedCellForeground="{StaticResource QsTealDarkBrush}"
                                     CurrentCellBackground="{StaticResource QsCurrentCellBrush}"
                                     CurrentRowBackground="{StaticResource QsCurrentRowBrush}"
                                     MissingObjectBackground="{StaticResource QsCellNoDataBrush}"
                                     FontFamily="{StaticResource QsFontFamily}"
                                     FontSize="{StaticResource QsFontSize}"
                                     Foreground="{StaticResource QsTextBrush}" />
                </ScrollViewer>

                <Canvas IsHitTestVisible="False">
                    <Border x:Name="HintPanel"
                            Canvas.Left="{Binding Hint.Anchor.X, Mode=OneWay, FallbackValue=0}"
                            Canvas.Top="{Binding Hint.Anchor.Y, Mode=OneWay, FallbackValue=0}">
                        <Border.Style>
                            <!--
                                A DataTrigger rather than a converter: "no hint" is null, and there
                                is no boolean in the view-model to convert.  Adding one would be a
                                second way to say the same thing.
                            -->
                            <Style TargetType="Border" BasedOn="{StaticResource QsHintPanel}">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Hint}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <!--
                            §G.2: the Delphi fixes this at 240 x ~116, which leaves most of the panel
                            empty for a two-line hint.  Size to content instead; QsHintPanel caps the
                            width at 320.
                        -->
                        <StackPanel>
                            <!--
                                No FontWeight.  The Delphi's hint is one plain TLabel, lblDataHint,
                                with no Font.Style (MainQuickStat.dfm:1463); the port splits it over
                                two lines, and the SemiBold that used to sit here drew nothing
                                anyway (PORT-PLAN.md §8.11 (14)).  Promoting it to Bold would be a
                                divergence rather than a fix.
                            -->
                            <TextBlock Foreground="{StaticResource QsTextBrush}"
                                       Text="{Binding Hint.Line1, Mode=OneWay}"
                                       TextWrapping="Wrap" />
                            <TextBlock Foreground="{StaticResource QsTextBrush}"
                                       Text="{Binding Hint.Line2, Mode=OneWay}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </Canvas>
            </Grid>
        </Border>
    </DockPanel>
</UserControl>

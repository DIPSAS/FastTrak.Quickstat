<UserControl x:Class="QuickStat.Views.CollectionsTabView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:anon="clr-namespace:QuickStat.Domain.Anonymisation;assembly=QuickStat.Core"
             xmlns:conv="clr-namespace:QuickStat.Converters"
             xmlns:q="clr-namespace:QuickStat.Controls"
             xmlns:theme="clr-namespace:QuickStat.Theme"
             xmlns:vm="clr-namespace:QuickStat.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:CollectionsTabViewModel}">

    <!--
        OWNER: step 3.3.  Layout skeleton by step 3.1; 05-ui-spec.md §B.2.

        The radio group and the timestamp box are wired to their real, shared homes -
        IIdentificationPolicy and IShellWorkspace - because a second copy of either is a privacy or
        a data-format defect rather than a layout detail.
    -->

    <DockPanel Margin="4">
        <q:SectionHeader DockPanel.Dock="Top" Margin="3" Header="Select data elements" />

        <TextBlock DockPanel.Dock="Top"
                   Margin="6,0,6,6"
                   LineHeight="17"
                   Text="{x:Static vm:CollectionsTabViewModel.InfoParagraph}"
                   TextWrapping="Wrap" />

        <!--
            ADDITION, product owner 2026-09-02: the same filter the population tab has, immediately
            above the list.  PORT-PLAN.md §7.3, 05-ui-spec.md §B.2 item 2a.  Label and placeholder
            are PopulationPickerView's, down to the cue-banner behaviour - Windows hides an
            EM_SETCUEBANNER hint while the control has focus, so the placeholder does the same.

            It drives CollectionsTabViewModel.VisibleDataElements, which hides rows and nothing else:
            a ticked element the filter is hiding is still collected, in the same export column.
        -->
        <StackPanel DockPanel.Dock="Top" Margin="3,0,3,3">
            <TextBlock Margin="0,0,0,2" Text="{x:Static vm:CollectionsTabViewModel.FilterHeader}" />

            <Grid>
                <TextBox x:Name="FilterBox"
                         Style="{StaticResource QsFlatTextBox}"
                         Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock Margin="7,4"
                           Foreground="{StaticResource QsMutedTextBrush}"
                           IsHitTestVisible="False"
                           Text="{x:Static vm:CollectionsTabViewModel.FilterPlaceholder}">
                    <TextBlock.Style>
                        <Style TargetType="{x:Type TextBlock}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding Text, ElementName=FilterBox}" Value="" />
                                        <Condition Binding="{Binding IsKeyboardFocusWithin, ElementName=FilterBox}" Value="False" />
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible" />
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom" Margin="3,0,3,3">
            <q:SectionHeader Margin="0,3" Header="Export options" />

            <RadioButton Margin="0,3"
                         Content="Fully identified patients"
                         GroupName="Identification"
                         IsChecked="{Binding Identification, Converter={conv:EnumToBooleanConverter}, ConverterParameter={x:Static anon:PersonIdentification.Full}}" />

            <RadioButton Margin="0,3"
                         Content="Identified with PID only"
                         GroupName="Identification"
                         IsChecked="{Binding Identification, Converter={conv:EnumToBooleanConverter}, ConverterParameter={x:Static anon:PersonIdentification.PersonIdOnly}}" />

            <!-- The .dfm caption has a trailing space; §B.2 says to drop it. -->
            <RadioButton Margin="0,3"
                         Content="Generate new random PIDs"
                         GroupName="Identification"
                         IsChecked="{Binding Identification, Converter={conv:EnumToBooleanConverter}, ConverterParameter={x:Static anon:PersonIdentification.RandomPersonId}}" />

            <CheckBox Margin="0,8"
                      Content="Export timestamp for every data element"
                      IsChecked="{Binding ExportTimestamps, Mode=TwoWay}" />
        </StackPanel>

        <Button DockPanel.Dock="Bottom"
                Margin="3"
                Style="{StaticResource QsPrimaryButton}"
                Command="{Binding CollectDataCommand}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Style="{StaticResource QsIconGlyph}"
                           Margin="0,0,8,0"
                           FontSize="20"
                           Text="{x:Static theme:SegoeIcons.Collect}" />
                <TextBlock VerticalAlignment="Center" Text="Collect data" />
            </StackPanel>
        </Button>

        <Grid Margin="3,0,3,3">
            <!--
                VisibleDataElements, not DataElements: the filtered projection.  Same instances, same
                order, minus what the box excludes - and everything that asks the view-model what to
                collect still reads DataElements, so a hidden tick is still a column.
            -->
            <ListBox x:Name="ElementsList"
                     BorderBrush="{StaticResource QsBorderBrush}"
                     BorderThickness="1"
                     HorizontalContentAlignment="Stretch"
                     ItemsSource="{Binding VisibleDataElements}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemContainerStyle>
                    <!--
                        QsCheckListItem's own Padding is moved onto the row's Border below, so the
                        collecting highlight spans the whole row rather than stopping 4 px short of
                        each edge.  The theme is not touched: this is BasedOn it and overrides one
                        setter.
                    -->
                    <Style TargetType="{x:Type ListBoxItem}" BasedOn="{StaticResource QsCheckListItem}">
                        <Setter Property="Padding" Value="0" />

                        <!--
                            Without this the row announces
                            "QuickStat.ViewModels.DataElementViewModel", 213 times over - measured on
                            the running build.  The tick inside the row does carry its title, because
                            a CheckBox is a ContentControl and the title is its Content; the row that
                            wraps it is what a screen reader lands on first, and it had no name of
                            its own.  DataElementViewModel.ToString is the backstop for the paths
                            that reach an item without a container to read this from.
                        -->
                        <Setter Property="AutomationProperties.Name" Value="{Binding Title}" />
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:DataElementViewModel}">
                        <!--
                            §G.4.  The Delphi sets ItemIndex := n for the element it is collecting,
                            so the run reads as a highlight travelling down the list; the port marks
                            IsCollecting instead and leaves SelectedItem where the user left it.  The
                            colours are the theme's selection pair, which is what the highlight looks
                            like in Docs/Screenshots/QuickStat bilde 2.png.
                        -->
                        <!--
                            The 2 px of vertical padding used to be on this Border, which has a
                            transparent background and is therefore hit-testable: those pixels
                            belonged to the border and not to the box, so 6 of every 21 px of row
                            height toggled nothing and only moved the selection - and two adjacent
                            rows made a 6 px dead band.  The border keeps the horizontal inset, so
                            the collecting highlight still spans the full width; MinHeight makes the
                            box fill the row instead.

                            MinHeight also pins the row at exactly 21 px.  It used to be 21.098,
                            taken from the text's natural height, so with item scrolling every row
                            below the first sat at a fractional offset and the dead band landed
                            somewhere different on each one.  CheckListHitTargetTests measures all
                            of this by hit-testing every pixel down the row, and fails on the old
                            markup with three dead pixels at each end instead of one.
                        -->
                        <Border x:Name="CollectingHighlight" Background="Transparent" Padding="4,0">
                            <CheckBox x:Name="ElementBox"
                                      MinHeight="19"
                                      VerticalContentAlignment="Center"
                                      Content="{Binding Title}"
                                      IsChecked="{Binding IsChecked, Mode=TwoWay}" />
                        </Border>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsCollecting}" Value="True">
                                <Setter TargetName="CollectingHighlight"
                                        Property="Background"
                                        Value="{StaticResource QsTealBrush}" />
                                <Setter TargetName="ElementBox"
                                        Property="Foreground"
                                        Value="{StaticResource QsOnAccentBrush}" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!--
                Inside the list's own border, so the rectangle does not vanish - the same shape the
                population list uses for its empty states, and the same reason.
            -->
            <TextBlock Margin="16"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Foreground="{StaticResource QsMutedTextBrush}"
                       IsHitTestVisible="False"
                       Text="{x:Static vm:CollectionsTabViewModel.NoMatchesText}"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       Visibility="{Binding ShowNoMatches, Converter={conv:BoolToVisibilityConverter}}" />
        </Grid>
    </DockPanel>
</UserControl>

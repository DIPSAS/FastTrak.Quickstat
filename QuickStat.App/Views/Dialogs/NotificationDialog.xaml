<Window x:Class="QuickStat.Views.Dialogs.NotificationDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:QuickStat.Converters"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:diag="clr-namespace:QuickStat.Diagnostics;assembly=QuickStat.Core"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:QuickStat.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:NotificationViewModel}"
        Title="{Binding Title}"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        SizeToContent="WidthAndHeight"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        WindowStartupLocation="CenterOwner">

    <!--
        OWNER: step 3.6.  The themed replacement for MessageBox, shown by
        QuickStat.Services.WpfNotificationPresenter.  05-ui-spec.md §D.4 enumerates every message
        the workflow raises; §I.7 records that their button sets and icons come from the logging
        framework rather than from the application, which is what this reproduces:

          * one OK button for a statement (Emetra.Logging.Base.pas:124-125, the default set);
          * Yes and No for a confirmation (:134-140), affirmative on the left, which is what
            MessageDlg lays out and what Windows expects - deliberately the opposite of the two
            ported .dfm forms, where the .dfm puts OK on the right;
          * the icon from the severity (:218-226), with an informational *question* promoted to a
            question mark (:276-277).

        The default button is No, not the Delphi's mbYes (:135).  The only confirmation QuickStat
        raises deletes a package, and IUserNotificationPresenter.AskAsync's contract is that there
        must be no path to true by omission.  One attribute to reverse.

        The message is rendered verbatim: UserNotifier has already run PiiRedactor.ForDisplay over
        it, so the handlebars are gone and the literal \n escapes in MainQuickStat.pas's resource
        strings are real line breaks (07-ui-contracts.md §5 decision (d)).  Do not convert again.
    -->

    <Window.Resources>
        <ResourceDictionary Source="/QuickStat;component/Theme/QuickStat.Styles.xaml" />
    </Window.Resources>

    <DockPanel MinWidth="320"
               MaxWidth="560"
               Background="{StaticResource QsFormFaceBrush}"
               TextElement.FontFamily="{StaticResource QsFontFamily}"
               TextElement.FontSize="{StaticResource QsFontSize}"
               TextElement.Foreground="{StaticResource QsTextBrush}">

        <Border DockPanel.Dock="Bottom"
                Height="48"
                BorderBrush="{StaticResource QsBorderBrush}"
                BorderThickness="0,1,0,0">
            <StackPanel HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">
                <Button x:Name="YesButton"
                        Width="92"
                        Height="30"
                        Margin="0,0,4,0"
                        Style="{StaticResource QsPrimaryButton}"
                        Content="{x:Static vm:NotificationViewModel.YesCaption}"
                        Click="OnYes"
                        Visibility="{Binding IsQuestion, Converter={conv:BoolToVisibilityConverter}}" />

                <!--
                    One button carries both "No" and "OK": Escape, Enter and the close box must all
                    reach the same place, and two buttons each claiming IsDefault and IsCancel - one
                    of them collapsed - is exactly the kind of thing that works until it does not.
                -->
                <Button x:Name="DismissButton"
                        Width="92"
                        Height="30"
                        Margin="4,0,16,0"
                        Style="{StaticResource QsPrimaryButton}"
                        Content="{Binding DismissText}"
                        IsCancel="True"
                        IsDefault="True" />
            </StackPanel>
        </Border>

        <Grid Margin="20,20,20,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="GlyphText"
                       Grid.Column="0"
                       Margin="0,0,16,0"
                       VerticalAlignment="Top"
                       Text="{Binding Glyph}">
                <TextBlock.Style>
                    <!--
                        Both severity colours were literals here until Phase 5 promoted them into
                        §F.4 (PORT-PLAN.md §8.10 e).  Step 3.6 wrote them inline because it was not
                        allowed to add a brush, and said so; the hex is unchanged, it just lives in
                        one place now, which matters because the banner uses the same red.
                    -->
                    <Style TargetType="TextBlock" BasedOn="{StaticResource QsIconGlyph}">
                        <Setter Property="FontSize" Value="32" />
                        <Setter Property="Foreground" Value="{StaticResource QsTealBrush}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Severity}" Value="{x:Static diag:NotificationSeverity.Warning}">
                                <Setter Property="Foreground" Value="{StaticResource QsWarningBrush}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Severity}" Value="{x:Static diag:NotificationSeverity.Error}">
                                <Setter Property="Foreground" Value="{StaticResource QsErrorBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <TextBlock x:Name="MessageText"
                       Grid.Column="1"
                       MinHeight="32"
                       VerticalAlignment="Center"
                       Text="{Binding Message}"
                       TextWrapping="Wrap" />
        </Grid>
    </DockPanel>
</Window>

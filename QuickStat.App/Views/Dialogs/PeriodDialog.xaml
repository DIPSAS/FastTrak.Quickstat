<Window x:Class="QuickStat.Views.Dialogs.PeriodDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:QuickStat.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:PeriodViewModel}"
        Title="{x:Static vm:PeriodViewModel.DialogHeader}"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        SizeToContent="WidthAndHeight"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        WindowStartupLocation="CenterOwner">

    <!--
        OWNER: step 3.6.  05-ui-spec.md §D.5, Emetra.VclForm.Period.dfm.

        Fully Norwegian, unlike the rest of the chrome: this is a library form, and PORT-PLAN.md
        §8.6 keeps the English-chrome / Norwegian-data split exactly as it is.

        Metrics come from the .dfm, which is what a QuickStat user sees: MainQuickStat.pas:272
        constructs TPeriodDictionary through the two-argument constructor, so fGuiStyle is nil and
        UpdateStyle - the only thing that would have resized the form to 525 - never runs.
        ClientWidth 527, ClientHeight 374; banner 45; button bar 50; two 241 x 227 calendars at 16
        from the left with 11 between them.

        SizeToContent, not Width/Height: those are the *outer* frame in WPF and the .dfm numbers are
        the client area.  With NoResize the difference is roughly 16 x 39, which is a whole row of
        the calendar.

        The theme is merged here rather than inherited from Application.Resources so the window can
        be loaded on its own - Application.Current is null under test (07-ui-contracts.md §6), and a
        dialog that cannot be constructed without one cannot be checked at all.  For the same reason
        no StaticResource appears on the Window element itself: the root panel below carries them,
        where the resource dictionary is unambiguously already in scope.
    -->

    <Window.Resources>
        <ResourceDictionary Source="/QuickStat;component/Theme/QuickStat.Styles.xaml" />
    </Window.Resources>

    <DockPanel Width="527"
               Height="374"
               Background="{StaticResource QsFormFaceBrush}"
               TextElement.FontFamily="{StaticResource QsFontFamily}"
               TextElement.FontSize="{StaticResource QsFontSize}"
               TextElement.Foreground="{StaticResource QsTextBrush}">

        <!-- panWhiteTop: header 19 px over the run-time sub-header, both 16 from the left. -->
        <Border x:Name="Banner"
                DockPanel.Dock="Top"
                Height="45"
                Background="{StaticResource QsBannerBrush}"
                BorderBrush="{StaticResource QsBorderBrush}"
                BorderThickness="0,0,0,1">
            <StackPanel Margin="16,0" VerticalAlignment="Center">
                <TextBlock FontSize="19"
                           FontWeight="SemiBold"
                           Text="{x:Static vm:PeriodViewModel.DialogHeader}" />
                <TextBlock Foreground="{StaticResource QsMutedTextBrush}"
                           Text="{Binding SubHeaderText}"
                           TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </Border>

        <!--
            panButtons.  lblBottomRightInfo is inside this bar despite its name: Align = alClient
            with Margins.Left = 16 puts it at the *left*, vertically centred and word-wrapped, with
            the two buttons docked right.  OK is the rightmost of the two (btnOk.Left = 427 against
            btnCancel.Left = 335), which is the opposite of the usual Windows order.
        -->
        <Border DockPanel.Dock="Bottom"
                Height="50"
                BorderBrush="{StaticResource QsBorderBrush}"
                BorderThickness="0,1,0,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right"
                            VerticalAlignment="Center"
                            Orientation="Horizontal">
                    <Button Width="84"
                            Height="36"
                            Margin="0,0,8,0"
                            Style="{StaticResource QsPrimaryButton}"
                            Content="{x:Static vm:PeriodViewModel.CancelCaption}"
                            IsCancel="True" />
                    <Button x:Name="OkButton"
                            Width="84"
                            Height="36"
                            Margin="0,0,16,0"
                            Style="{StaticResource QsPrimaryButton}"
                            Content="{x:Static vm:PeriodViewModel.AcceptCaption}"
                            IsDefault="True"
                            IsEnabled="{Binding CanAccept}"
                            Click="OnAccept" />
                </StackPanel>

                <TextBlock x:Name="BottomInfo"
                           Margin="16,0,8,0"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource QsMutedTextBrush}"
                           Text="{Binding BottomInfoText}"
                           TextWrapping="Wrap" />
            </DockPanel>
        </Border>

        <Grid Margin="16,16,16,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0"
                       Foreground="{StaticResource QsMutedTextBrush}"
                       Text="{x:Static vm:PeriodViewModel.TipText}"
                       TextWrapping="Wrap" />

            <!--
                FirstDayOfWeek is pinned to Monday rather than left to the current culture, because
                dwMonday is what the .dfm says and a build agent in en-US must render the same grid.
                IsTodayHighlighted follows HighlightToday = False, which is set on both calendars.
                ShowDayOfWeek = False, set on the left calendar only, has no WPF equivalent - the
                day-of-week row is part of Calendar's template - and it is an inconsistency between
                the two calendars in the original anyway.
            -->
            <StackPanel Grid.Row="1" Margin="0,4,0,0" Orientation="Horizontal">
                <Calendar x:Name="StartCalendar"
                          Width="241"
                          Margin="0,0,11,0"
                          VerticalAlignment="Top"
                          AutomationProperties.Name="Første dato"
                          DisplayDateStart="{x:Static vm:PeriodViewModel.FirstDate}"
                          FirstDayOfWeek="Monday"
                          IsTodayHighlighted="False"
                          SelectedDate="{Binding SelectedStart, Mode=TwoWay}"
                          SelectionMode="SingleDate" />

                <Calendar x:Name="StopCalendar"
                          Width="241"
                          VerticalAlignment="Top"
                          AutomationProperties.Name="Siste dato"
                          DisplayDateStart="{x:Static vm:PeriodViewModel.FirstDate}"
                          FirstDayOfWeek="Monday"
                          IsTodayHighlighted="False"
                          SelectedDate="{Binding SelectedStop, Mode=TwoWay}"
                          SelectionMode="SingleDate" />
            </StackPanel>
        </Grid>
    </DockPanel>
</Window>

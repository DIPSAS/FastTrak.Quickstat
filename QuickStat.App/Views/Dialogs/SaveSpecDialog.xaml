<Window x:Class="QuickStat.Views.Dialogs.SaveSpecDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:QuickStat.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:SaveSpecViewModel}"
        Title="{Binding Header}"
        Width="388"
        Height="288"
        Background="{StaticResource QsFormFaceBrush}"
        FontFamily="{StaticResource QsFontFamily}"
        FontSize="{StaticResource QsFontSize}"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        SizeToContent="Manual"
        WindowStartupLocation="CenterOwner">

    <!--
        OWNER: step 3.6.  Layout skeleton by step 3.1; 05-ui-spec.md §E.
        Only one header is ever used - "Save specification".  The second, "Save selection", belongs
        to actSavePatientSelection, which PORT-PLAN.md §7.1 removes as unreachable; see
        SaveSpecViewModel for why §I.3 therefore does not arise.
    -->

    <DockPanel>
        <Border DockPanel.Dock="Top"
                Height="41"
                Background="{StaticResource QsBannerBrush}"
                BorderBrush="{StaticResource QsBorderBrush}"
                BorderThickness="0,0,0,1">
            <TextBlock Margin="16,0"
                       VerticalAlignment="Center"
                       FontSize="19"
                       FontWeight="Bold"
                       Text="{Binding Header}" />
        </Border>

        <Border DockPanel.Dock="Bottom"
                Height="48"
                BorderBrush="{StaticResource QsBorderBrush}"
                BorderThickness="0,1,0,0">
            <StackPanel HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">
                <Button Width="92"
                        Height="30"
                        Margin="0,0,4,0"
                        Content="OK"
                        IsDefault="True"
                        IsEnabled="{Binding CanSave}"
                        Click="OnAccept" />
                <Button Width="88"
                        Height="30"
                        Margin="0,0,16,0"
                        Content="Cancel"
                        IsCancel="True" />
            </StackPanel>
        </Border>

        <StackPanel Margin="16">
            <TextBlock Text="Unique name" />
            <TextBox Height="21"
                     Margin="0,2,0,0"
                     Style="{StaticResource QsFlatTextBox}"
                     Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" />

            <TextBlock Margin="0,8,0,0" Text="Comments" />
            <TextBox Height="90"
                     Margin="0,2,0,0"
                     Style="{StaticResource QsFlatTextBox}"
                     AcceptsReturn="True"
                     Text="{Binding Comment, UpdateSourceTrigger=PropertyChanged}"
                     TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto" />
        </StackPanel>
    </DockPanel>
</Window>

<Window x:Class="QuickStat.Views.Dialogs.SaveSpecDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:theme="clr-namespace:QuickStat.Theme"
        xmlns:vm="clr-namespace:QuickStat.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:SaveSpecViewModel}"
        Title="{Binding Header}"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        SizeToContent="WidthAndHeight"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        WindowStartupLocation="CenterOwner">

    <!--
        OWNER: step 3.6.  05-ui-spec.md §E, Emetra.VclForm.EditAndMemo.dfm.

        ClientWidth 388 x ClientHeight 288; banner 41 with a 32 px icon 16 from the left and the
        header beside it at 19 px; body with a 16 px border all round; button bar 48.  SizeToContent
        rather than Width/Height because those are the outer frame in WPF and these are the client
        area - NoResize still costs about 16 x 39, which here is most of the comment box.

        SetHeader sets the title bar and the banner from one string, so both bind to Header.  Only
        one header is ever used - "Save specification".  The second, "Save selection", belongs to
        actSavePatientSelection, which PORT-PLAN.md §7.1 removes as unreachable; see
        SaveSpecViewModel for why §I.3 therefore does not arise.

        The theme is merged here rather than inherited from Application.Resources so the window can
        be loaded without one; Application.Current is null under test (07-ui-contracts.md §6).
    -->

    <Window.Resources>
        <ResourceDictionary Source="/QuickStat;component/Theme/QuickStat.Styles.xaml" />
    </Window.Resources>

    <DockPanel Width="388"
               Height="288"
               Background="{StaticResource QsFormFaceBrush}"
               TextElement.FontFamily="{StaticResource QsFontFamily}"
               TextElement.FontSize="{StaticResource QsFontSize}"
               TextElement.Foreground="{StaticResource QsTextBrush}"
               FocusManager.FocusedElement="{Binding ElementName=TitleBox}">

        <!--
            Panel1: white, 41 tall, one-pixel bottom rule.  The .dfm has a 32 x 33 TImage here; step
            3.1's decision (b) substitutes a Segoe MDL2 glyph for every image-list blob, and this
            dialog packages a dataset, so it is the same parcel the grid menu uses.
        -->
        <Border x:Name="Banner"
                DockPanel.Dock="Top"
                Height="41"
                Background="{StaticResource QsBannerBrush}"
                BorderBrush="{StaticResource QsBorderBrush}"
                BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal">
                <TextBlock Width="32"
                           Margin="16,0,3,0"
                           Style="{StaticResource QsIconGlyph}"
                           FontSize="22"
                           Foreground="{StaticResource QsTealBrush}"
                           Text="{x:Static theme:SegoeIcons.Package}" />

                <TextBlock x:Name="HeaderText"
                           VerticalAlignment="Center"
                           FontSize="19"
                           FontWeight="Bold"
                           Text="{Binding Header}"
                           TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </Border>

        <!--
            panButtons: 48 tall, one-pixel top rule.  Sizes and spacing are the .dfm's - OK 92 x 30,
            Cancel 88 x 30, 4 + 4 between them, 16 to the right edge.

            The ORDER is not.  btnSave.Left is 280 against btnClose.Left 184, so the Delphi puts OK
            on the right, which is the opposite of what Windows does everywhere else - including
            NotificationDialog next door, which has always read Yes then No.  Switched to the
            platform order on the product owner's instruction, 2026-09-01: commit first, dismiss
            second, left to right.  A deliberate divergence; PORT-PLAN.md §7.3.
        -->
        <Border DockPanel.Dock="Bottom"
                Height="48"
                BorderBrush="{StaticResource QsBorderBrush}"
                BorderThickness="0,1,0,0">
            <StackPanel HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">
                <Button x:Name="OkButton"
                        Width="92"
                        Height="30"
                        Margin="0,0,4,0"
                        Style="{StaticResource QsPrimaryButton}"
                        Content="OK"
                        IsDefault="True"
                        IsEnabled="{Binding CanSave}"
                        Click="OnAccept" />
                <Button x:Name="CancelButton"
                        Width="88"
                        Height="30"
                        Margin="4,0,16,0"
                        Style="{StaticResource QsPrimaryButton}"
                        Content="Cancel"
                        IsCancel="True" />
            </StackPanel>
        </Border>

        <!-- Panel2: BorderWidth = 16 on all four sides; the comment box takes what is left. -->
        <Grid Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Margin="0,0,0,1" Text="Unique name" />

            <!--
                MaxLength is a deliberate divergence from edtTitle, which has none
                (Emetra.VclForm.EditAndMemo.dfm:931-943).  Report.QuickStat.Title is varchar(80) and
                Report.AddQuickStat upserts on (StudyId, Title), so past 80 characters the Delphi
                does not merely lose the tail - it silently writes over the package whose title
                shared those 80.  Stopping the typing is the only place that can be said; there is
                no error to catch, at any layer.  PORT-PLAN.md §8.11 (13).

                The comment box below is deliberately uncapped: Comment is varchar(MAX).
            -->
            <TextBox x:Name="TitleBox"
                     Grid.Row="1"
                     Height="21"
                     Margin="0,0,0,1"
                     Style="{StaticResource QsFlatTextBox}"
                     AutomationProperties.Name="Unique name"
                     MaxLength="{x:Static vm:SaveSpecViewModel.MaxTitleLength}"
                     Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" />

            <TextBlock Grid.Row="2" Margin="0,4,0,1" Text="Comments" />

            <TextBox x:Name="CommentBox"
                     Grid.Row="3"
                     Style="{StaticResource QsFlatTextBox}"
                     AcceptsReturn="True"
                     AutomationProperties.Name="Comments"
                     Text="{Binding Comment, UpdateSourceTrigger=PropertyChanged}"
                     TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto" />
        </Grid>
    </DockPanel>
</Window>

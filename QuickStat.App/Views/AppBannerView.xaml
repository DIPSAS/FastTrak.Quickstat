<UserControl x:Class="QuickStat.Views.AppBannerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:QuickStat.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
             Height="55"
             Background="{StaticResource QsBannerBrush}">

    <!--
        05-ui-spec.md §A.2 / §A.3, panWhiteTop.  Height 55 including the one-pixel bottom rule; icon
        32 x 32 at Margin 15,3,0,3; the wordmark; the version pair; and the Progress block pinned
        right at 295 wide.  Step 3.1 owns this file.
    -->

    <Border BorderBrush="{StaticResource QsBorderBrush}" BorderThickness="0,0,0,1">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="295" />
            </Grid.ColumnDefinitions>

            <!--
                The .ico embedded by the .csproj as an assembly resource.  A multi-resolution icon:
                DecodePixelWidth picks the 32 px frame rather than scaling the largest one down.
            -->
            <Image Grid.Column="0"
                   Width="32"
                   Height="32"
                   Margin="15,3,0,3"
                   VerticalAlignment="Center"
                   RenderOptions.BitmapScalingMode="HighQuality"
                   AutomationProperties.Name="QuickStat">
                <Image.Source>
                    <BitmapImage UriSource="pack://application:,,,/QuickStat;component/Assets/QuickStat_Icon.ico"
                                 DecodePixelWidth="32" />
                </Image.Source>
            </Image>

            <TextBlock Grid.Column="1"
                       Margin="6,3,3,3"
                       VerticalAlignment="Center"
                       FontSize="{StaticResource QsWordmarkFontSize}"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource QsTextBrush}"
                       Text="{Binding ProductName, Mode=OneTime}" />

            <!--
                Delphi TRzVersionInfoStatus: the word "version" in #0078D7 and the number in black,
                bound to the assembly's FileVersion.  Nothing sets a version in this repository, so
                it reads 1.0.0.0 - see IApplicationInfo.Version; that is a packaging decision, not a
                thing to invent here.
            -->
            <TextBlock Grid.Column="2"
                       Margin="12,3,3,3"
                       VerticalAlignment="Center"
                       FontSize="{StaticResource QsFontSize}">
                <Run Foreground="{StaticResource QsAccentBrush}" Text="version " />
                <Run Foreground="{StaticResource QsTextBrush}" Text="{Binding VersionText, Mode=OneWay}" />
            </TextBlock>

            <StackPanel Grid.Column="4" Margin="3,3,8,3" VerticalAlignment="Center">
                <TextBlock FontWeight="SemiBold"
                           FontSize="{StaticResource QsFontSize}"
                           Foreground="{StaticResource QsTextBrush}"
                           Text="{Binding ProgressHeader, Mode=OneWay}" />

                <TextBlock Margin="0,1,0,0"
                           FontSize="{StaticResource QsFontSize}"
                           TextTrimming="CharacterEllipsis"
                           Text="{Binding ProgressInfo, Mode=OneWay}"
                           ToolTip="{Binding ProgressInfo, Mode=OneWay}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{StaticResource QsMutedTextBrush}" />
                            <Style.Triggers>
                                <!--
                                    §G.2: a failure while building the data hint turns lblInfo red
                                    and shows the exception message.  Any Fail() does the same.
                                -->
                                <DataTrigger Binding="{Binding ProgressIsError}" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource QsErrorBrush}" />
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <ProgressBar Margin="0,3,0,0"
                             Style="{StaticResource QsProgressBar}"
                             Value="{Binding ProgressPercent, Mode=OneWay}" />
            </StackPanel>
        </Grid>
    </Border>
</UserControl>

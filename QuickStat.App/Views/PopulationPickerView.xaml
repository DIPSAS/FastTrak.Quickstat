<UserControl x:Class="QuickStat.Views.PopulationPickerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:conv="clr-namespace:QuickStat.Converters"
             xmlns:input="clr-namespace:QuickStat.Input"
             xmlns:vm="clr-namespace:QuickStat.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:PopulationPickerViewModel}">

    <!--
        OWNER: step 3.2.  05-ui-spec.md §B.1.1, the embedded TfrmPopulations frame.  The four English
        captions are the ones TfrmQuickStat.FormCreate writes over the Norwegian .dfm ones at run
        time (MainQuickStat.pas:289-292).
    -->

    <UserControl.Resources>

        <!--
            The three text runs turn white together when the row is selected (§B.1.1).  Title and
            help text need no rule: QsPopulationItem sets Foreground on the container, and its
            selection triggers set TextElement.Foreground - the same dependency property - so both
            inherit.  Only the two runs that carry an explicit colour of their own have to be told.
        -->
        <Style x:Key="PopulationCodeRun" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{StaticResource QsCodeBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType={x:Type ListBoxItem}}}"
                             Value="True">
                    <Setter Property="Foreground" Value="{StaticResource QsOnAccentBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PopulationGroupRun" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{StaticResource QsCategoryBrush}" />
            <Setter Property="FontSize" Value="{StaticResource QsSmallFontSize}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType={x:Type ListBoxItem}}}"
                             Value="True">
                    <Setter Property="Foreground" Value="{StaticResource QsOnAccentBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!--
            Expansion, Emetra.VclComp.ListView.pas:752-755.  The second trigger comes after the first
            on purpose: a row with no HelpText has nothing to expand, and the VCL adds no height for
            an empty description either (MeasureItem, :551-561).
        -->
        <Style x:Key="PopulationHelpRun" TargetType="{x:Type TextBlock}">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding HelpText}" Value="">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="120" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Margin="0,0,0,2" Text="Filter / search text" />

        <!--
            edtPopFilter.  TextHint is EM_SETCUEBANNER, which Windows hides while the control has
            focus, so the placeholder does the same.
        -->
        <Grid Grid.Row="1">
            <TextBox x:Name="FilterBox"
                     Style="{StaticResource QsFlatTextBox}"
                     Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}" />

            <TextBlock Margin="7,4"
                       Foreground="{StaticResource QsMutedTextBrush}"
                       IsHitTestVisible="False"
                       Text="Type filter text here">
                <TextBlock.Style>
                    <Style TargetType="{x:Type TextBlock}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding Text, ElementName=FilterBox}" Value="" />
                                    <Condition Binding="{Binding IsKeyboardFocusWithin, ElementName=FilterBox}" Value="False" />
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Visibility" Value="Visible" />
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Grid>

        <Grid Grid.Row="2" Height="28">
            <CheckBox VerticalAlignment="Center"
                      Content="Frequently used only"
                      IsChecked="{Binding FrequentlyUsedOnly, Mode=TwoWay}"
                      IsEnabled="{Binding CanFilterFrequentlyUsed}" />

            <!--
                cbSimpleView, Alignment = taLeftJustify: the caption sits to the LEFT of the box.

                QsCaptionLeftCheckBox, not a local FlowDirection.  RightToLeft mirrors the whole
                visual subtree, and the default template draws the tick as a Path - so a hand-rolled
                version comes out with the checkmark pointing down-left, which putting the caption
                back to LeftToRight cannot reach because the mark lives inside the template.  The
                style sets FlowDirection and VerticalAlignment itself; setting either here would be
                a local value, which beats a style setter, and the defect would be back.

                TODO (merge): QsCaptionLeftCheckBox was added to Theme/QuickStat.Styles.xaml on
                feature/dotnet AFTER branch agent-3-2 was cut, so it is not in this worktree and
                QuickStat.exe cannot start here - "Cannot find resource named
                'QsCaptionLeftCheckBox'".  The build is unaffected: StaticResource resolves at load,
                not at compile time.  This is expected and resolves the moment the branch is merged;
                Ui/Theme/ThemeResourceTests.cs then confirms the key exists.  Written this way on
                the coordinator's instruction rather than reinvented locally.
            -->
            <CheckBox HorizontalAlignment="Right"
                      Style="{StaticResource QsCaptionLeftCheckBox}"
                      FontSize="{StaticResource QsSmallFontSize}"
                      IsChecked="{Binding Simplified, Mode=TwoWay}">
                <TextBlock FlowDirection="LeftToRight" Text="Simplified" />
            </CheckBox>
        </Grid>

        <Grid Grid.Row="3">
            <!--
                IsSharedSizeScope is what makes the id column one width for the whole list rather
                than one per row: the VCL grid has real columns and widens column 0 to the widest id
                it has painted (Emetra.VclComp.ListView.pas:322, 639-640), so without this the titles
                would not line up once the ids differ in length.
            -->
            <!--
                Enter behaves like a double click (Emetra.VclComp.ListView.pas:762-766), and the
                double click itself is the whole point of the list (§B.1.1).  Both are guarded by
                the command's CanExecute, which is what the Delphi's TryGetHighlightedPopulation
                guard amounts to.

                The two gestures are spelled differently on purpose.  A MouseBinding here would
                never fire - ListBoxItem handles the mouse-down it selects itself with, so the
                event stops below the ListBox that owns the binding.  input:DoubleClick hangs off
                Control.MouseDoubleClick, which the item raises and lets bubble.  See its remarks.
            -->
            <ListBox x:Name="PopulationList"
                     AlternationCount="2"
                     BorderBrush="{StaticResource QsBorderBrush}"
                     BorderThickness="1"
                     Grid.IsSharedSizeScope="True"
                     HorizontalContentAlignment="Stretch"
                     input:DoubleClick.Command="{Binding PreparePopulationCommand}"
                     ItemsSource="{Binding Populations}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     SelectedItem="{Binding SelectedPopulation, Mode=TwoWay}">

                <!--
                    QsPopulationItem plus the one thing the theme cannot supply: the row's accessible
                    name.  The chrome is shared, the name is this row's content, and a theme style
                    that named a view-model property would only be right for one of the three lists
                    that use these keys.  BasedOn, so the alternation, the divider and both selection
                    pairs are still the theme's.
                -->
                <ListBox.ItemContainerStyle>
                    <Style TargetType="{x:Type ListBoxItem}" BasedOn="{StaticResource QsPopulationItem}">
                        <Setter Property="AutomationProperties.Name" Value="{Binding AutomationName}" />
                    </Style>
                </ListBox.ItemContainerStyle>

                <ListBox.InputBindings>
                    <KeyBinding Key="Enter" Command="{Binding PreparePopulationCommand}" />
                </ListBox.InputBindings>

                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:PopulationViewModel}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <!-- 24 + 2 x GapX, and it grows to fit the widest id. -->
                                <ColumnDefinition Width="Auto" MinWidth="32" SharedSizeGroup="PopulationId" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Row="0"
                                       Grid.Column="0"
                                       Style="{StaticResource PopulationCodeRun}"
                                       Text="{Binding ProcId}" />

                            <!--
                                ProcGroup is drawn INSIDE the title column, right-aligned, and the
                                title is trimmed to whatever is left - PaintContents shortens the
                                rectangle by the group's width before it draws the title
                                (Emetra.VclComp.ListView.pas:665-683).
                            -->
                            <Grid Grid.Row="0" Grid.Column="1" Margin="4,0,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0"
                                           FontWeight="Bold"
                                           Text="{Binding Title}"
                                           TextTrimming="CharacterEllipsis" />

                                <TextBlock Grid.Column="1"
                                           Margin="4,0,0,0"
                                           VerticalAlignment="Center"
                                           Style="{StaticResource PopulationGroupRun}"
                                           Text="{Binding Group}" />
                            </Grid>

                            <TextBlock Grid.Row="1"
                                       Grid.Column="1"
                                       Margin="4,0,0,0"
                                       Style="{StaticResource PopulationHelpRun}"
                                       Text="{Binding HelpText}"
                                       TextWrapping="Wrap" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!--
                §B.1.1: the VCL hides the whole grid when the filtered list is empty
                (Emetra.VclComp.ListView.pas:524).  A message inside the same border says the same
                thing without the rectangle vanishing.  Deliberate improvement, recorded on
                PopulationPickerViewModel.NoPopulationsText.
            -->
            <TextBlock Margin="16"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Foreground="{StaticResource QsMutedTextBrush}"
                       IsHitTestVisible="False"
                       Text="{Binding EmptyStateText}"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       Visibility="{Binding IsEmpty, Converter={conv:BoolToVisibilityConverter}}" />
        </Grid>

        <!--
            splitMain, SplitterWidth = 9, FixedPane = fpLowerRight: the list keeps the slack and the
            preview keeps its height.  Both rows are Auto, so with the preview hidden - which is how
            it starts, see PopulationPickerViewModel.ShowSourceCode - the pair takes no space at all.
            A drag turns the preview's row into an absolute height, which is what makes it resizable
            at all.
        -->
        <GridSplitter Grid.Row="4"
                      Height="9"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Center"
                      Background="{StaticResource QsPageBrush}"
                      ResizeBehavior="PreviousAndNext"
                      ResizeDirection="Rows"
                      Visibility="{Binding ShowSourceCode, Converter={conv:BoolToVisibilityConverter}}" />

        <!--
            memSourceCode: read-only, no word wrap, Consolas 8 pt (§B.1.1 item 7, §I.9).  In the
            Delphi the pane is gated by FUNC_POPULATION_SOURCE; here it is the user's own
            'Show source' box on the tab around this frame - see ShowSourceCode for why.
        -->
        <TextBox Grid.Row="5"
                 MinHeight="104"
                 AcceptsReturn="True"
                 Background="{StaticResource QsSurfaceBrush}"
                 BorderBrush="{StaticResource QsBorderBrush}"
                 BorderThickness="1"
                 FontFamily="{StaticResource QsCodeFontFamily}"
                 FontSize="{StaticResource QsSmallFontSize}"
                 HorizontalScrollBarVisibility="Auto"
                 IsReadOnly="True"
                 Text="{Binding SqlPreview, Mode=OneWay}"
                 TextWrapping="NoWrap"
                 VerticalScrollBarVisibility="Auto"
                 Visibility="{Binding ShowSourceCode, Converter={conv:BoolToVisibilityConverter}}" />
    </Grid>
</UserControl>

<Project Sdk="Microsoft.NET.Sdk">

  <!--
    QuickStat.Tests - xUnit v2 on VSTest.

    RUNNER CHOICE, READ BEFORE CHANGING: do not "upgrade" this to xunit.v3.  It was tried and it
    breaks "dotnet test" on this SDK - the suite reports "Zero tests ran" even though the tests pass
    when the test binary is run directly.  The full evidence is in Directory.Packages.props.

    net10.0-windows + UseWPF because the suite references QuickStat.App (which is WPF) as well as
    QuickStat.Core.

    DATABASE: everything must still be unit-testable without a server (PORT-PLAN.md §9 R9), and a
    plain "dotnet test" reaches no network.  The one exception is Live/, whose tests skip themselves
    unless QUICKSTAT_LIVE_CONNECTION names a database - see Live/LiveDatabase.cs for why they exist
    and what they may not print.  Skipped, not passed: a test that returns quietly when its
    precondition is missing reports success for having done nothing.
  -->

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>QuickStat.Tests</RootNamespace>
    <AssemblyName>QuickStat.Tests</AssemblyName>
    <IsTestProject>true</IsTestProject>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\QuickStat.App\QuickStat.App.csproj" />
    <ProjectReference Include="..\QuickStat.Core\QuickStat.Core.csproj" />
  </ItemGroup>

</Project>

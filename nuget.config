<?xml version="1.0" encoding="utf-8"?>
<configuration>

  <!--
    Required, not optional.

    The machine-level NuGet config (%APPDATA%\NuGet\NuGet.Config) defines two remote feeds -
    nuget.org and the internal Hemit_public_packages Azure Artifacts feed.  Central Package
    Management raises NU1507 whenever more than one source is in play without package source
    mapping, and this repository treats warnings as errors, so restore fails outright.

    Every dependency in Directory.Packages.props is a public package from nuget.org, so the fix is
    to clear the inherited sources and declare that one feed.  It also removes any dependency-
    confusion exposure between the public and internal feeds.

    If a QuickStat dependency ever has to come from the internal feed, add it back here together
    with a <packageSourceMapping> section - not by deleting this file.
  -->

  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>

</configuration>
